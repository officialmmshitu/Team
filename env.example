# Copy to .env (all optional for local development)
PORT=4000
NODE_ENV=development

# Public address users open. Used in password-reset links. Use https:// in production.
APP_URL=http://localhost:4000   # also used in manager invitation emails

# Set to 1 only when running behind a reverse proxy (nginx, Caddy, Render, Fly...) so client IPs are read correctly.
TRUST_PROXY=0

# Password-reset emails via Resend (https://resend.com). Without these, reset links are printed to the server console.
RESEND_API_KEY=
MAIL_FROM="IMI Platform <no-reply@yourdomain.com>"

# Optional: where the SQLite database lives (default data/imi.db). Back this file up.
# DB_FILE=/var/data/imi.db

# Email confirmation at signup (default on). Set to 0 only to launch before email delivery is configured.
# REQUIRE_EMAIL_VERIFICATION=1

# First super admin (optional). Created on the first start ONLY if no super admin exists yet, so a password you change later is never put back.
# After you log in, change the password under My account and delete SUPER_ADMIN_PASSWORD from this file. Password: 10+ characters.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# Browser setup: if no administrator exists, the login page offers "Set up the admin account".
# On the computer running the server it needs nothing. From anywhere else it asks for a code, printed in the server console (or set your own here).
# SETUP_CODE=
